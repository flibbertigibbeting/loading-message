{
  "name": "@flibbertigibbeting/loading-message",
  "version": "0.2.0",
  "description": "React component for delightful loading messages",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "loading",
    "spinner",
    "loading-message",
    "flibbertigibbeting"
  ],
  "author": "flibbertigibbeting",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flibbertigibbeting/loading-message.git"
  },
  "homepage": "https://flibbertigibbeting.dev",
  "bugs": {
    "url": "https://github.com/flibbertigibbeting/loading-message/issues"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
